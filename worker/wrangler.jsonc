{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigh",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Its own hostname, so calls from the page are cross-origin. The client sends them as
  // simple requests (text/plain) so nothing preflights, and every reply carries
  // access-control-allow-origin so the page may read it.
  "routes": [
    { "pattern": "sigh-worker.holyhell.xyz", "custom_domain": true }
  ],

  // Public, not a secret: it is the origin the page is served from, and the Worker both
  // echoes it back as the allowed origin and rejects requests claiming anything else.
  "vars": {
    "PAGE_ORIGIN": "https://sigh.holyhell.xyz"
  },

  // Top level, not under "unsafe". Rate limiting graduated to a first-class binding; the
  // old unsafe.bindings form still uploads and still appears in `wrangler deploy` output,
  // but limit() then returns success unconditionally.
  //
  // period must be 10 on a free account. A period of 60 deploys clean, prints the limit
  // back, and enforces correctly under `wrangler dev` (which does not model plan
  // entitlements), then silently never enforces in production. Both limits below are
  // expressed per 10s for that reason, at the rates originally intended.
  "ratelimits": [
    {
      // Keyed on the device hash. Note this is not an abuse control: the key arrives in
      // the request body, so anyone inflating the count sends a fresh hash each time and
      // never trips it. It stops one honest browser mashing, which is all it is for.
      // 10 presses per 10s leaves room to mash; beyond that the client shows its gentle
      // "that one is not counted" line rather than an error.
      "name": "DEVICE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 10 }
    },
    {
      // Deliberately loose (100/10s is the same rate as the 600/min originally wanted).
      // A large organisation routes many people through few egress addresses, so a tight
      // read a whole building as one abusive client and refuse legitimate presses.
      "name": "IP_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 10 }
    }
  ]

  // Secrets, set with `wrangler secret put`, never in this file:
  //   SUPABASE_URL, SUPABASE_SERVICE_KEY, ROOM_PEPPER, ADMIN_TOKEN
}
