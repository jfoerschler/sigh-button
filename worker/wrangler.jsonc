{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigh",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Its own hostname, so calls from the page are cross-origin. The client sends them as
  // simple requests (text/plain) so nothing preflights, and every reply carries
  // access-control-allow-origin so the page may read it.
  "routes": [
    { "pattern": "sigh-worker.holyhell.xyz", "custom_domain": true }
  ],

  // Public, not a secret: it is the origin the page is served from, and the Worker both
  // echoes it back as the allowed origin and rejects requests claiming anything else.
  "vars": {
    "PAGE_ORIGIN": "https://sigh.holyhell.xyz"
  },

  "unsafe": {
    "bindings": [
      {
        // The control that actually matters. Keyed on the device hash, which is
        // already in the payload, so it costs no extra identifying data.
        "name": "DEVICE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        // Deliberately loose. BU routes many people through few egress addresses,
        // so a tight per-IP rule would read a whole building as one abusive client
        // and refuse legitimate presses. This only catches a script on one machine.
        "name": "IP_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 600, "period": 60 }
      }
    ]
  }

  // Secrets, set with `wrangler secret put`, never in this file:
  //   SUPABASE_URL, SUPABASE_SERVICE_KEY, ROOM_PEPPER, ADMIN_TOKEN
}
